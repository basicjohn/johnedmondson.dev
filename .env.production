# Public build-time value: NEXT_PUBLIC_* is inlined into the client bundle,
# and this URL already ships in the current production JavaScript. Not a
# secret — the API Gateway resource is deliberately open.
#
# Path is /contact rather than /submit. Both resources exist on the deployed
# stage, but only /contact is declared in
# amplify/backend/api/contactFormApi/cli-inputs.json — an `amplify push`
# reconciling the stack could drop the undeclared one.
#
# "staging" is the API Gateway stage name, not an environment. It is the
# stage production has always used; amplify/team-provider-info.json defines
# no other.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://9t0tc13wwe.execute-api.us-east-2.amazonaws.com/staging/contact
